---
import '../styles/global.css';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
  /** 分享卡片配图，默认用站点卡片图；项目详情页会传自己的封面 */
  ogImage?: string;
  /** 分享卡片上的标题，默认跟页面标题一致 */
  ogTitle?: string;
}

const { title, description = site.description, ogImage = '/og-default.png', ogTitle } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.title}`;

const siteUrl = (Astro.site ?? new URL('https://zhaopeng-portfolio.pages.dev')).href.replace(/\/$/, '');
const canonical = `${siteUrl}${Astro.url.pathname}`.replace(/\/$/, '') || siteUrl;
// 微信 / QQ 的分享卡片只认 jpg、png，svg 用不了 —— 碰到就换回站点默认卡片图
const useDefaultImage = !/\.(jpe?g|png)$/i.test(ogImage);
const shareImage = useDefaultImage ? '/og-default.png' : ogImage;
const ogImageUrl = shareImage.startsWith('http') ? shareImage : `${siteUrl}${shareImage}`;
const shareTitle = ogTitle ?? pageTitle;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    <!-- 分享到微信 / QQ / 微博时显示的卡片 -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    {
      useDefaultImage && (
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- 访问统计：site.ts 里留空这段就不加载 -->
    {
      site.analyticsToken && (
        <script
          is:inline
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${site.analyticsToken}"}`}
        ></script>
      )
    }
  </head>
  <body class="bg-white text-zinc-900">
    <header class="no-print border-b border-zinc-200">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-5 py-4 sm:px-6 sm:py-5">
        <a href="/" class="text-base font-semibold tracking-tight text-ink-900 hover:text-ink-700">
          {site.name}
        </a>
        <nav class="flex items-center gap-4 text-sm text-zinc-600 sm:gap-6">
          <a href="/" class="hover:text-ink-700">成果</a>
          <a href="/tags" class="hover:text-ink-700">标签</a>
          <a href="/search" class="hover:text-ink-700">搜索</a>
          <a href="/about" class="hidden hover:text-ink-700 sm:inline">关于</a>
          <a
            href="/admin/"
            class="rounded-md bg-ink-800 px-3 py-1.5 text-white transition hover:bg-ink-900"
            >记一笔</a
          >
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-5 py-10 sm:px-6 sm:py-12">
      <slot />
    </main>

    <footer class="no-print mt-14 border-t border-zinc-200">
      <div
        class="mx-auto flex max-w-5xl flex-col gap-3 px-5 py-8 text-sm text-zinc-500 sm:flex-row sm:items-center sm:justify-between sm:px-6"
      >
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
          <span>© {new Date().getFullYear()} {site.author}</span>
          <a href={`mailto:${site.email}`} class="text-ink-700 hover:text-ink-900">{site.email}</a>
        </div>
        <div class="flex flex-wrap items-center gap-4">
          {
            site.links.map((l) => (
              <a href={l.url} class="hover:text-ink-700" target="_blank" rel="noopener">
                {l.name}
              </a>
            ))
          }
          <span id="visit-count" class="hidden items-center gap-1.5" title="本站累计访问次数">
            <span class="h-1.5 w-1.5 rounded-full bg-ink-500"></span>
            累计访问 <span id="visit-total">0</span> 次
          </span>
          <a href="/about" class="hover:text-ink-700 sm:hidden">关于</a>
          <a href="/admin/" class="text-zinc-400 hover:text-ink-700">后台</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      // 底部访问计数：拿到数字才显示，拿不到就整块不出现，页面不会留个「0 次」
      (function () {
        var box = document.getElementById('visit-count');
        var num = document.getElementById('visit-total');
        if (!box || !num) return;
        fetch('/api/hit')
          .then(function (r) {
            return r.json();
          })
          .then(function (d) {
            if (!d || !d.ok || typeof d.total !== 'number') return;
            num.textContent = d.total.toLocaleString('zh-CN');
            box.classList.remove('hidden');
            box.classList.add('inline-flex');
          })
          .catch(function () {});
      })();
    </script>
  </body>
</html>
