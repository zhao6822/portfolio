---
import { existsSync } from 'node:fs';
import path from 'node:path';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  /** 首屏可见的卡片传 true：立刻加载，不用等滚动 */
  priority?: boolean;
}

const { project, priority = false } = Astro.props;
const { title, summary, period, role, status, tags, metrics, cover } = project.data;

const statusStyle: Record<string, string> = {
  进行中: 'bg-amber-50 text-amber-700 border-amber-200',
  已交付: 'bg-ink-50 text-ink-700 border-ink-200',
  已归档: 'bg-zinc-100 text-zinc-600 border-zinc-200',
};

const firstChar = (title || '?').trim().charAt(0);

// 后台删掉封面图后，条目里的封面地址会变成死链。这里构建时先确认文件还在，
// 不在就直接显示占位图，免得页面上出现一张加载不出来的破图。
const coverExists =
  !cover ||
  !cover.startsWith('/') ||
  existsSync(path.join(process.cwd(), 'public', cover.replace(/^\//, '')));

// 构建时如果生成了 800px 的小图，列表卡片就只加载小图（142KB 而不是 292KB）
const smallCover = cover ? cover.replace(/\.(jpe?g|png)$/i, (ext) => `-800${ext}`) : '';
const hasSmall =
  !!smallCover &&
  smallCover !== cover &&
  existsSync(path.join(process.cwd(), 'public', smallCover.replace(/^\//, '')));
---

<a
  href={`/projects/${project.id}/`}
  class="group flex flex-col overflow-hidden rounded-xl border border-zinc-200 bg-white transition hover:border-ink-300 hover:shadow-sm"
>
  {
    cover && coverExists ? (
      <div class="aspect-[16/9] w-full overflow-hidden bg-ink-50">
        <img
          src={hasSmall ? smallCover : cover}
          srcset={hasSmall ? `${smallCover} 800w, ${cover} 1600w` : undefined}
          sizes={hasSmall ? '(min-width: 640px) 480px, 100vw' : undefined}
          alt={title}
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : 'auto'}
          decoding="async"
          class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.02]"
        />
      </div>
    ) : (
      <div
        class="flex aspect-[16/9] w-full items-center justify-center bg-gradient-to-br from-[#1e4a3b] to-[#14352a]"
      >
        <span class="text-4xl font-semibold text-white/90">{firstChar}</span>
      </div>
    )
  }

  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-start justify-between gap-3">
      <h3 class="text-base font-semibold leading-snug group-hover:text-ink-800">{title}</h3>
      <span
        class={`shrink-0 rounded-full border px-2 py-0.5 text-xs ${statusStyle[status]}`}
        >{status}</span
      >
    </div>

    <p class="mt-2 text-sm leading-relaxed text-zinc-600">{summary}</p>

    {
      metrics.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
          {metrics.slice(0, 3).map((m) => (
            <div>
              <div class="text-sm font-semibold tabular-nums text-ink-800">{m.value}</div>
              <div class="text-xs text-zinc-500">{m.label}</div>
            </div>
          ))}
        </div>
      )
    }

    <div class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-1 pt-4 text-xs text-zinc-500">
      <span>{period}</span>
      <span class="text-zinc-300">·</span>
      <span>{role}</span>
    </div>

    {
      tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1.5">
          {tags.map((t) => (
            <span class="rounded-md bg-ink-50 px-2 py-0.5 text-xs text-ink-700">{t}</span>
          ))}
        </div>
      )
    }
  </div>
</a>
