---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site';
---

<BaseLayout title="关于">
  <h1 class="text-2xl font-semibold tracking-tight">关于</h1>

  <div class="prose-custom mt-6 max-w-2xl text-[15px] text-zinc-800">
    {site.about.map((p) => <p>{p}</p>)}
  </div>

  <dl class="mt-10 border-t border-zinc-200 pt-6 text-sm">
    <div class="flex gap-4 py-1.5">
      <dt class="w-16 shrink-0 text-zinc-500">邮箱</dt>
      <dd>
        <a href={`mailto:${site.email}`} class="underline">{site.email}</a>
      </dd>
    </div>
    {
      site.links.map((l) => (
        <div class="flex gap-4 py-1.5">
          <dt class="w-16 shrink-0 text-zinc-500">{l.name}</dt>
          <dd>
            <a href={l.url} target="_blank" rel="noopener" class="underline">
              {l.url}
            </a>
          </dd>
        </div>
      ))
    }
  </dl>

  <p class="mt-10 text-xs text-zinc-400">
    想改这些内容？编辑项目里的 <code class="rounded bg-zinc-100 px-1 py-0.5">src/site.ts</code> 文件。
  </p>
</BaseLayout>
