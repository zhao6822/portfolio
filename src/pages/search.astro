---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const all = await getCollection('projects');
const items = all
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((p) => ({
    title: p.data.title,
    summary: p.data.summary,
    tags: p.data.tags,
    period: p.data.period,
    role: p.data.role,
    status: p.data.status,
    year: p.data.date.getFullYear(),
    url: `/projects/${p.id}/`,
    body: (p.body ?? '').replace(/[#>*`\-\[\]()]/g, ' ').replace(/\s+/g, ' ').slice(0, 600),
  }));
---

<BaseLayout title="搜索">
  <h1 class="text-2xl font-semibold tracking-tight">搜索</h1>
  <p class="mt-2 text-sm text-zinc-500">
    找之前记过的东西：输关键词，标题、标签、正文都能搜到。
  </p>

  <div class="mt-6">
    <input
      id="search-input"
      type="search"
      placeholder="例如：会员体系、转化率、2026…"
      autocomplete="off"
      class="w-full rounded-lg border border-zinc-300 px-4 py-3 text-sm outline-none transition placeholder:text-zinc-400 focus:border-ink-500 focus:ring-2 focus:ring-ink-100"
    />
    <p id="search-count" class="mt-3 text-xs text-zinc-500"></p>
  </div>

  <div id="search-results" class="mt-6 grid gap-4"></div>

  <div id="search-empty" class="mt-10 hidden rounded-xl border border-dashed border-zinc-300 p-12 text-center">
    <p class="text-sm text-zinc-500">没有匹配的记录，换个词试试。</p>
  </div>

  <script define:vars={{ items }} is:inline>
    const input = document.getElementById('search-input');
    const list = document.getElementById('search-results');
    const empty = document.getElementById('search-empty');
    const count = document.getElementById('search-count');

    const esc = (s) =>
      String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    const statusClass = (s) =>
      s === '已交付'
        ? 'bg-ink-50 text-ink-700 border-ink-200'
        : s === '进行中'
          ? 'bg-amber-50 text-amber-700 border-amber-200'
          : 'bg-zinc-100 text-zinc-600 border-zinc-200';

    function render(q) {
      const key = q.trim().toLowerCase();
      const hits = key
        ? items.filter((it) =>
            [it.title, it.summary, it.period, it.role, it.tags.join(' '), it.body]
              .join(' ')
              .toLowerCase()
              .includes(key),
          )
        : items;

      count.textContent = key ? `匹配 ${hits.length} 条` : `共 ${items.length} 条记录`;
      empty.classList.toggle('hidden', hits.length > 0);

      list.innerHTML = hits
        .map((it) => {
          const snippet = it.body.slice(0, 110);
          return `<a href="${it.url}" class="block rounded-xl border border-zinc-200 p-5 transition hover:border-ink-300 hover:shadow-sm">
            <div class="flex items-start justify-between gap-3">
              <h3 class="text-base font-semibold leading-snug">${esc(it.title)}</h3>
              <span class="shrink-0 rounded-full border px-2 py-0.5 text-xs ${statusClass(it.status)}">${esc(it.status)}</span>
            </div>
            <p class="mt-2 text-sm leading-relaxed text-zinc-600">${esc(it.summary)}</p>
            <p class="mt-2 line-clamp-2 text-xs text-zinc-500">${esc(snippet)}</p>
            <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-zinc-500">
              <span>${esc(it.period)}</span>
              <span class="text-zinc-300">·</span>
              <span>${esc(it.role)}</span>
              ${
                it.tags.length
                  ? `<span class="ml-auto flex flex-wrap gap-1.5">${it.tags
                      .map((t) => `<span class="rounded-md bg-ink-50 px-2 py-0.5 text-ink-700">${esc(t)}</span>`)
                      .join('')}</span>`
                  : ''
              }
            </div>
          </a>`;
        })
        .join('');
    }

    input.addEventListener('input', (e) => render(e.target.value));
    render('');
  </script>
</BaseLayout>
