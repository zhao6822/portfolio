---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter((p) => !p.data.draft)
    .map((project) => ({
      params: { slug: project.id },
      props: { project },
    }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, period, role, status, tags, metrics, links, cover } =
  project.data;

const statusStyle: Record<string, string> = {
  进行中: 'bg-amber-50 text-amber-700 border-amber-200',
  已交付: 'bg-ink-50 text-ink-700 border-ink-200',
  已归档: 'bg-zinc-100 text-zinc-600 border-zinc-200',
};
---

<BaseLayout title={title} description={summary}>
  <article>
    <a href="/" class="text-sm text-zinc-500 hover:text-zinc-900">← 返回成果列表</a>

    <header class="mt-6">
      <div class="flex flex-wrap items-center gap-3">
        <span
          class={`rounded-full border px-2.5 py-0.5 text-xs ${statusStyle[status]}`}
          >{status}</span
        >
        <span class="text-sm text-zinc-500">{period}</span>
      </div>
      <h1 class="mt-3 text-2xl font-semibold tracking-tight sm:text-3xl">
        {title}
      </h1>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-zinc-600">
        {summary}
      </p>
    </header>

    {
      cover && (
        <div class="mt-8 overflow-hidden rounded-xl border border-zinc-200 bg-zinc-50">
          <img src={cover} alt={title} class="w-full object-cover" />
        </div>
      )
    }

    {
      metrics.length > 0 && (
        <section class="mt-8 grid gap-4 sm:grid-cols-3">
          {metrics.map((m) => (
            <div class="rounded-xl border border-ink-100 bg-ink-50 p-5">
              <div class="text-2xl font-semibold tabular-nums text-ink-900">{m.value}</div>
              <div class="mt-1 text-sm text-ink-700">{m.label}</div>
            </div>
          ))}
        </section>
      )
    }

    <dl
      class="mt-8 grid gap-x-8 gap-y-4 border-y border-zinc-200 py-6 text-sm sm:grid-cols-2"
    >
      <div class="flex gap-3">
        <dt class="w-16 shrink-0 text-zinc-500">起止</dt>
        <dd>{period}</dd>
      </div>
      <div class="flex gap-3">
        <dt class="w-16 shrink-0 text-zinc-500">角色</dt>
        <dd>{role}</dd>
      </div>
      {
        tags.length > 0 && (
          <div class="flex gap-3 sm:col-span-2">
            <dt class="w-16 shrink-0 text-zinc-500">标签</dt>
            <dd class="flex flex-wrap gap-1.5">
              {tags.map((t) => (
                <a
                  href={`/tags/${encodeURIComponent(t)}/`}
                  class="rounded-md bg-ink-50 px-2 py-0.5 text-xs text-ink-700 hover:bg-ink-100"
                >
                  {t}
                </a>
              ))}
            </dd>
          </div>
        )
      }
    </dl>

    <div class="prose-custom mt-8 max-w-none text-[15px] text-zinc-800">
      <Content />
    </div>

    {
      links.length > 0 && (
        <section class="mt-10 border-t border-zinc-200 pt-6">
          <h2 class="mb-3 text-sm font-medium text-zinc-500">相关链接</h2>
          <div class="flex flex-wrap gap-3">
            {links.map((l) => (
              <a
                href={l.url}
                target="_blank"
                rel="noopener"
                class="rounded-md border border-zinc-300 px-3 py-1.5 text-sm hover:bg-zinc-50"
              >
                {l.name} ↗
              </a>
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
