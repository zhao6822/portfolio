---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../site';

const all = await getCollection('projects');
const projects = all
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const years = [...new Set(projects.map((p) => p.data.date.getFullYear()))].sort(
  (a, b) => b - a
);

const tagCount = new Map<string, number>();
for (const p of projects) {
  for (const t of p.data.tags) {
    tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
  }
}
const tags = [...tagCount.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout>
  <section class="mb-14">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
      {site.author}
    </h1>
    <p class="mt-3 max-w-2xl text-base leading-relaxed text-zinc-600">
      {site.intro}
    </p>
    <p class="mt-4 text-sm text-zinc-500">
      共 {projects.length} 个项目成果 · {years[0] ?? '—'} 至今
    </p>
  </section>

  {
    tags.length > 0 && (
      <section class="mb-10">
        <div class="flex flex-wrap gap-2">
          {tags.map(([tag, count]) => (
            <a
              href={`/tags/${encodeURIComponent(tag)}/`}
              class="rounded-full border border-zinc-200 px-3 py-1 text-xs text-zinc-600 transition hover:border-zinc-400 hover:text-zinc-900"
            >
              {tag}
              <span class="ml-1 text-zinc-400">{count}</span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    projects.length === 0 ? (
      <div class="rounded-xl border border-dashed border-zinc-300 p-12 text-center">
        <p class="text-sm text-zinc-500">
          还没有内容。打开 <a href="/admin/" class="underline">后台</a> 添加第一个项目成果。
        </p>
      </div>
    ) : (
      years.map((year) => (
        <section class="mb-12">
          <h2 class="mb-5 text-sm font-medium tracking-wide text-zinc-400">{year}</h2>
          <div class="grid gap-5 sm:grid-cols-2">
            {projects
              .filter((p) => p.data.date.getFullYear() === year)
              .map((p) => (
                <ProjectCard project={p} />
              ))}
          </div>
        </section>
      ))
    )
  }
</BaseLayout>
