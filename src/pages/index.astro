---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../site';

const all = await getCollection('projects');
const projects = all
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const years = [...new Set(projects.map((p) => p.data.date.getFullYear()))].sort(
  (a, b) => b - a
);

const tagCount = new Map<string, number>();
for (const p of projects) {
  for (const t of p.data.tags) {
    tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
  }
}
const tags = [...tagCount.entries()].sort((a, b) => b[1] - a[1]);

const metricCount = projects.reduce((n, p) => n + p.data.metrics.length, 0);
const yearText =
  years.length > 0
    ? years.length === 1
      ? `${years[0]}`
      : `${years[years.length - 1]}–${years[0]}`
    : '—';
---

<BaseLayout>
  <!-- 首屏：名字 + 定位 + 关键词 -->
  <section class="mb-12">
    <div class="flex flex-col-reverse gap-6 sm:flex-row sm:items-start sm:justify-between">
      <div class="flex-1">
        <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
          {site.author}
        </h1>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-zinc-600">
          {site.intro}
        </p>
        {
          site.keywords.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {site.keywords.map((k) => (
                <span class="rounded-full bg-ink-50 px-3 py-1 text-xs text-ink-700 ring-1 ring-ink-100">
                  {k}
                </span>
              ))}
            </div>
          )
        }
      </div>
      {
        site.avatar && (
          <img
            src={site.avatar}
            alt={site.author}
            class="h-20 w-20 shrink-0 rounded-full object-cover ring-1 ring-zinc-200 sm:h-24 sm:w-24"
          />
        )
      }
    </div>

    <!-- 数据概览 -->
    <dl class="mt-8 grid grid-cols-3 gap-4 border-y border-zinc-200 py-5">
      <div>
        <dt class="text-xs text-zinc-500">项目成果</dt>
        <dd class="mt-1 text-xl font-semibold tabular-nums text-ink-800">{projects.length}</dd>
      </div>
      <div>
        <dt class="text-xs text-zinc-500">覆盖年份</dt>
        <dd class="mt-1 text-xl font-semibold tabular-nums text-ink-800">{yearText}</dd>
      </div>
      <div>
        <dt class="text-xs text-zinc-500">量化数据</dt>
        <dd class="mt-1 text-xl font-semibold tabular-nums text-ink-800">{metricCount}</dd>
      </div>
    </dl>
  </section>

  {
    tags.length > 0 && (
      <section class="mb-10">
        <div class="flex flex-wrap gap-2">
          {tags.map(([tag, count]) => (
            <a
              href={`/tags/${encodeURIComponent(tag)}/`}
              class="rounded-full border border-zinc-200 px-3 py-1 text-xs text-zinc-600 transition hover:border-ink-300 hover:bg-ink-50 hover:text-ink-700"
            >
              {tag}
              <span class="ml-1 text-zinc-400">{count}</span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    projects.length === 0 ? (
      <div class="rounded-xl border border-dashed border-zinc-300 p-12 text-center">
        <p class="text-sm text-zinc-500">
          还没有内容。打开 <a href="/admin/" class="text-ink-700 underline">后台</a> 添加第一个项目成果。
        </p>
      </div>
    ) : (
      years.map((year) => (
        <section class="mb-12">
          <h2 class="mb-5 text-sm font-medium tracking-wide text-ink-600">{year}</h2>
          <div class="grid gap-5 sm:grid-cols-2">
            {projects
              .filter((p) => p.data.date.getFullYear() === year)
              .map((p, i) => (
                <ProjectCard project={p} priority={i < 2} />
              ))}
          </div>
        </section>
      ))
    )
  }

  <!-- 自己用的记录入口 -->
  <section class="mb-12 rounded-xl bg-ink-50 p-6 ring-1 ring-ink-100">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h2 class="text-sm font-medium text-ink-900">刚做完点什么？记一笔</h2>
        <p class="mt-1 text-xs text-ink-700">
          有结果就写结果，没结果就先记过程。勾选「草稿」的内容只有你自己能在后台看到，不会公开。
        </p>
      </div>
      <a
        href="/admin/"
        class="shrink-0 rounded-md bg-ink-800 px-4 py-2 text-sm text-white transition hover:bg-ink-900"
        >去记录</a
      >
    </div>
  </section>

  <!-- 对外：联系方式 -->
  <section class="mb-4 rounded-xl border border-zinc-200 p-6">
    <h2 class="text-sm font-medium text-zinc-900">聊聊？</h2>
    <p class="mt-1 text-sm text-zinc-600">看项目有疑问，或者想聊聊合作，直接发邮件就行。</p>
    <div class="mt-4 flex flex-wrap gap-3">
      <a
        href={`mailto:${site.email}`}
        class="rounded-md bg-ink-800 px-4 py-2 text-sm text-white transition hover:bg-ink-900"
        >发邮件</a
      >
      {
        site.resumeUrl && (
          <a
            href={site.resumeUrl}
            target="_blank"
            rel="noopener"
            class="rounded-md border border-zinc-300 px-4 py-2 text-sm text-zinc-700 transition hover:border-ink-300 hover:text-ink-700"
          >
            下载简历 PDF
          </a>
        )
      }
    </div>
  </section>
</BaseLayout>
